{
  "manifest_version": 3,
  "name": "hired.log — Save Job Applications",
  "description": "Save job postings from LinkedIn, Indeed, Kalibrr and more to your hired.log dashboard with one click.",
  "version": "1.0.0",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/jobs/*",
        "*://*.linkedin.com/job/*",
        "*://*.indeed.com/*",
        "*://*.kalibrr.com/*"
      ],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/background.js"
  }
}
